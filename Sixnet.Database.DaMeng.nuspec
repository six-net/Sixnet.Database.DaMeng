<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Sixnet.Database.DaMeng</id>
    <version>$version$</version>
    <title></title>
    <authors>DingBin.Li</authors>
    <owners>DingBin.Li</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/sixnet-net</projectUrl>
    <icon>images\nugeticon.png</icon>
    <description>Provides access to DaMeng databases based on the Sixnet development framework</description>
    <copyright>Copyright © DingBin.Li</copyright>
    <tags>.NET,Sixnet,DaMeng</tags>
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Sixnet" version="2.1.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
	<file src="Libs\DM.DmProvider.dll" target="lib\netstandard2.1" />
    <file src="Sixnet.Database.DaMeng\bin\$configuration$\netstandard2.1\Sixnet.Database.DaMeng.dll" target="lib\netstandard2.1" />
	<file src="Sixnet.Database.DaMeng\bin\$configuration$\netstandard2.1\Sixnet.Database.DaMeng.pdb" target="lib\netstandard2.1" />
	<file src=".\nugeticon.png" target="images\" />
  </files>
</package>